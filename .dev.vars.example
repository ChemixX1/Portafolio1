# Rename this file from .dev.vars.example to .dev.vars and paste in your credentials

ENVIRONMENT=development

# Optional canonical origin for a custom production domain, without a trailing slash.
# When omitted, the application uses the origin of the current request.
SITE_URL=https://your-domain.example

# Free access key from https://web3forms.com — messages are sent to the
# email address you used to register there.
WEB3FORMS_ACCESS_KEY=PASTE_YOUR_ACCESS_KEY

# This is a random string used for the session cookie for saving the preferred theme
SESSION_SECRET=KEEP_IT_SECRET_KEEP_IT_SAFE
